<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Nova Capital"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaCapital">

        <!-- Pantalla principal -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lista de proyectos -->
        <activity android:name=".activities.ListaProyectosActivity" />

        <!-- Crear proyecto -->
        <activity android:name=".activities.CrearProyectoActivity" />

        <!-- Detalle de proyecto -->
        <activity android:name=".activities.DetalleProyectoActivity" />

        <!-- Perfil del usuario -->
        <activity android:name=".activities.PerfilActivity" />

        <!-- Retos -->
        <activity android:name=".activities.RetosActivity" />

    </application>

</manifest>
