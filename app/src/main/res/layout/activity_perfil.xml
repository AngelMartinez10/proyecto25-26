<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil del usuario e historial de inversiones -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Cabecera del perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1565C0"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="48sp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inversor"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvSaldoAurus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1000 Aurus"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFD54F"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Estadísticas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@android:color/white"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNumInversiones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inversiones: 0"
            android:textSize="14sp"
            android:textColor="#424242"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvNumProyectos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Proyectos: 0"
            android:textSize="14sp"
            android:textColor="#424242"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Título historial -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de Inversiones"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#424242"
        android:padding="16dp"
        android:background="@android:color/white"
        android:layout_marginBottom="4dp"/>

    <!-- Lista de inversiones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
