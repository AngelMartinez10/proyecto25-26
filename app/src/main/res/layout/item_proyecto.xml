<?xml version="1.0" encoding="utf-8"?>
<!-- Item de la lista de proyectos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp"
    android:layout_margin="6dp"
    android:elevation="2dp">

    <!-- Nombre del proyecto -->
    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del proyecto"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="4dp"/>

    <!-- Estado -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACTIVO"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Barra de progreso + porcentaje -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"/>

        <TextView
            android:id="@+id/tvPorcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="12sp"
            android:textColor="#424242"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Objetivo -->
    <TextView
        android:id="@+id/tvObjetivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Objetivo: 0 Aurus"
        android:textSize="13sp"
        android:textColor="#616161"/>

    <!-- Invertido -->
    <TextView
        android:id="@+id/tvInvertido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invertido: 0 Aurus"
        android:textSize="13sp"
        android:textColor="#2E7D32"
        android:layout_marginBottom="12dp"/>

    <!-- Botón Invertir -->
    <Button
        android:id="@+id/btnInvertir"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Invertir"
        android:textSize="14sp"
        android:backgroundTint="#1565C0"/>

</LinearLayout>
