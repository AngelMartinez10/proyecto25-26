<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario para crear un nuevo proyecto -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Proyecto"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:layout_marginBottom="24dp"/>

    <!-- Campo: Nombre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del proyecto"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Startup de tecnología"
        android:inputType="text"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Campo: Descripción -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descripción"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:hint="Describe el proyecto..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginBottom="16dp"/>

    <!-- Campo: Objetivo de inversión -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inversión objetivo (Aurus)"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etObjetivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 500"
        android:inputType="numberDecimal"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"
        android:layout_marginBottom="32dp"/>

    <!-- Botón crear -->
    <Button
        android:id="@+id/btnCrear"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Crear Proyecto"
        android:textSize="16sp"
        android:backgroundTint="#2E7D32"/>

</LinearLayout>
