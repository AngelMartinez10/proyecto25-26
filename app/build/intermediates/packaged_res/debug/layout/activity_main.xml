<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal de Nova Capital -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <!-- Logo / Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰 Nova Capital"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#1565C0"
        android:layout_marginBottom="8dp"/>

    <!-- Bienvenida con nombre del usuario -->
    <TextView
        android:id="@+id/tvBienvenida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Hola, Inversor!"
        android:textSize="18sp"
        android:textColor="#424242"
        android:layout_marginBottom="4dp"/>

    <!-- Saldo de Aurus -->
    <TextView
        android:id="@+id/tvSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saldo: 1000 Aurus"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFA000"
        android:layout_marginBottom="40dp"/>

    <!-- Botón: Ver proyectos -->
    <Button
        android:id="@+id/btnProyectos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📋  Ver Proyectos"
        android:textSize="16sp"
        android:backgroundTint="#1565C0"
        android:layout_marginBottom="12dp"/>

    <!-- Botón: Crear proyecto -->
    <Button
        android:id="@+id/btnCrearProyecto"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="➕  Crear Proyecto"
        android:textSize="16sp"
        android:backgroundTint="#2E7D32"
        android:layout_marginBottom="12dp"/>

    <!-- Botón: Perfil -->
    <Button
        android:id="@+id/btnPerfil"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="👤  Mi Perfil"
        android:textSize="16sp"
        android:backgroundTint="#6A1B9A"
        android:layout_marginBottom="12dp"/>

    <!-- Botón: Retos -->
    <Button
        android:id="@+id/btnRetos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🏆  Retos"
        android:textSize="16sp"
        android:backgroundTint="#E65100"/>

</LinearLayout>
